# CARD-Net environment configuration
# Copy to .env and fill in the values before running.

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cardnet:cardnet@localhost:5432/cardnet

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_32_BYTE_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS / Security ────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
# TRUSTED_HOSTS=["localhost","127.0.0.1"]

# ── File Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# ── ML ─────────────────────────────────────────────────────────────────────────
MODEL_DIR=ml_models
# ACTIVE_MODEL_VERSION=tabnet_v1   # filename stem of the .pkl file

# ── Fraud Thresholds ───────────────────────────────────────────────────────────
# These are unvalidated defaults. Adjust after proper threshold analysis.
FRAUD_THRESHOLD_LOW=0.3
FRAUD_THRESHOLD_HIGH=0.7

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development
